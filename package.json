{
  "name": "white-box",
  "version": "0.1.0",
  "private": true,
  "description": "White Box — 自己実行管理システム / 自分との約束を、現実の行動と成果までつなぐ実行基盤",
  "main": "dist-electron/presentation/main.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @white-box/renderer dev",
    "dev:app": "pnpm build:packages && concurrently -k -n vite,electron -c cyan,magenta \"pnpm --filter @white-box/renderer dev\" \"pnpm dev:electron:run\"",
    "dev:electron": "pnpm build:packages && pnpm dev:electron:run",
    "dev:electron:run": "tsc -p apps/desktop/tsconfig.json && wait-on tcp:127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://localhost:5273 electron .",
    "build": "pnpm build:packages && tsc -p apps/desktop/tsconfig.json && pnpm --filter @white-box/renderer build",
    "start": "npm run build && electron .",
    "app": "electron .",
    "typecheck": "pnpm build:packages && tsc -p apps/renderer/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint apps/renderer/src",
    "test": "pnpm build:packages && vitest run",
    "storybook": "pnpm --filter @white-box/renderer storybook",
    "icons": "node scripts/make-icon.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@white-box/contracts": "workspace:*",
    "@white-box/core": "workspace:*"
  },
  "author": "menma22",
  "build": {
    "appId": "dev.whitebox.app",
    "productName": "White Box",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "apps/desktop/src/presentation/preload.cjs",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "White Box"
    }
  },
  "packageManager": "pnpm@11.5.2"
}
