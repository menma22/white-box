{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../dist-electron",
    "rootDir": "src",
    "types": ["node", "electron"],
    "sourceMap": true
  },
  "include": ["src"]
}
