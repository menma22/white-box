{
  "name": "@white-box/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "両プロセスで使う純粋な時間計算と型。外部依存ゼロ",
  "exports": {
    "./activity": {
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./goal-map": {
      "types": "./dist/goal-map.d.ts",
      "default": "./dist/goal-map.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./outcome": {
      "types": "./dist/outcome.d.ts",
      "default": "./dist/outcome.js"
    },
    "./goal-criteria": {
      "types": "./dist/goal-criteria.d.ts",
      "default": "./dist/goal-criteria.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "default": "./dist/presence.js"
    },
    "./notes": {
      "types": "./dist/notes.d.ts",
      "default": "./dist/notes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
